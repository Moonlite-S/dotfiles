#!/usr/bin/env bash

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

#########################################
#  SAKURA MIKU – Pink Pill Theme        #
#########################################

# --- Color Palette ---
# Format: 0xAARRGGBB (Alpha, Red, Green, Blue)

# Transparent base for the main bar
BAR_TRANSPARENT="0x00000000"

# Pill Backgrounds
PILL_BG="0xcc1e1e2e"     # Dark surface with slight transparency
PILL_BORDER="0x80ff8fb3" # Semi-transparent pink border

# Accents
SAKURA_PRIMARY="0xffff8fb3" # Bright Sakura pink
SAKURA_MUTED="0xffd27e99"   # Softer, muted pink
HOT_PINK="0xffff427b"       # Punchy pink for active states

# Text Colors
TEXT_MAIN="0xffcdd6f4"
TEXT_DIM="0xffa6adc8"

##############################
#  Bar Configuration         #
##############################

sketchybar --bar position=top \
  height=36 \
  color=$BAR_TRANSPARENT \
  shadow=off \
  sticky=on \
  padding_left=10 \
  padding_right=10 \
  corner_radius=0 \
  border_width=0 \
  y_offset=4

################################
#  Global Item Defaults        #
################################

default=(
  # Font settings (Make sure the name matches Font Book exactly)
  # icon.font="JetBrainsMono Nerd Font:Bold:16.0"
  # label.font="JetBrainsMono Nerd Font:Medium:13.0"

  # Default text/icon colors
  icon.color=$SAKURA_PRIMARY
  label.color=$TEXT_MAIN

  # Internal spacing (inside the pill)
  icon.padding_left=10
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=10

  # External spacing (creates the gaps between individual pills)
  background.padding_left=4
  background.padding_right=4

  # Pill appearance
  background.color=$PILL_BG
  background.corner_radius=14
  background.height=28
  background.border_width=1
  background.border_color=$PILL_BORDER
  background.shadow.drawing=off
)

sketchybar --default "${default[@]}"

################################
#  LEFT: Spaces                #
################################

# Create 5 individual space pills
SPACE_ICONS=("一" "二" "三" "四" "五")

for i in "${!SPACE_ICONS[@]}"; do
  sid=$((i + 1))

  sketchybar --add space space.$sid left \
    --set space.$sid space=$sid \
    icon="${SPACE_ICONS[i]}" \
    icon.color=$SAKURA_MUTED \
    icon.highlight_color=$HOT_PINK \
    label.drawing=off \
    background.color=$PILL_BG \
    icon.padding_left=12 \
    icon.padding_right=12 \
    script="$PLUGIN_DIR/space.sh"
done

# A simple separator pill
sketchybar --add item separator left \
  --set separator icon="~" \
  icon.color=$TEXT_DIM \
  label.drawing=off \
  background.color=$BAR_TRANSPARENT \
  background.border_width=0

################################
# LEFT: Front App
################################

# Register the custom event
sketchybar --add event window_focus

sketchybar --add item front_app left \
  --set front_app icon="❯" \
  icon.color=$HOT_PINK \
  icon.font="JetBrainsMono Nerd Font:Bold:14.0" \
  icon.padding_left=12 \
  icon.padding_right=4 \
  label.color=$SAKURA_PRIMARY \
  label.font="JetBrainsMono Nerd Font:Bold:14.0" \
  label.padding_left=0 \
  label.padding_right=12 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched window_focus

################################
#  RIGHT: System Monitors      #
################################

# Clock
sketchybar --add item clock right \
  --set clock icon=󰥔 \
  icon.color=$SAKURA_PRIMARY \
  update_freq=10 \
  script="$PLUGIN_DIR/clock.sh"

# Volume
sketchybar --add item volume right \
  --set volume icon=󰕾 \
  icon.color=$SAKURA_MUTED \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

# Battery
sketchybar --add item battery right \
  --set battery icon=󰁹 \
  icon.color=$HOT_PINK \
  update_freq=60 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

#################
#  launch #
#################

sketchybar --update
